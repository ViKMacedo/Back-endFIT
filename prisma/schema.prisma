// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-ts"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mongodb"
  url = env("DATABASE_URL")
}

model Livro { 
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  nome       String
  publicado  String?
  autor      String

} 
